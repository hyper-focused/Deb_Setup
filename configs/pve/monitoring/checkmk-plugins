# check_mk agent-local plugins — Proxmox VE (bare metal)
# Prefer SNMP extends for generic host metrics. check_mk is required for:
#   - LibreNMS Proxmox application (agent-local "proxmox" — PVE API; no SNMP path)
#   - rrdcached / temperature extras
# Lines starting with # are skipped by init.sh.
# Exception: 'temperature' is served from configs/pve/monitoring/temperature
# init.sh always force-includes "proxmox" on PVE even if this list is incomplete.

proxmox     # REQUIRED: LibreNMS Proxmox app (VMs/CTs via PVE API) over check_mk
rrdcached   # RRDcached STATS over unix socket
temperature # CPU/system temps via lm-sensors (curated)

